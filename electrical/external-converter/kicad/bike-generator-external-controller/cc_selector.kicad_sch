	(text "CC / CV MANUAL-DIGITAL SELECTOR - PROVISIONAL TWO-WIRE INTERFACE"
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "ae25b01b-449b-48e2-b1df-9fa2e1394a65")
	)
	(text "GPIO20 HIGH / released / logic off: mechanical 100k controls on NC.\nGPIO20 LOW after SPI setup: Q22 powers both coils; digital W/B selected on NO.\nMCP42100 /RS and /SHDN held high. Switching is external to the digipot."
		(at 25.4 232.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e1f1c9a6-a3f3-411a-bb80-3d7a7f5a029c")
	)
	(text "QUALIFY BEFORE CONNECTION: each CC/CV port must really be a TWO-WIRE rheostat.\nIn digital mode all A/W/B terminals must stay within 0...3V3 and +/-1mA.\nNo analog terminal is permanently grounded. Both contacts open during transfer;\nrelay timing, contact bounce, brownout and converter feedback response are UNQUALIFIED.\nExternal manual pots: 100k; connect wiper + one end, preferably bond unused end to wiper."
		(at 25.4 254 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2e55379a-4ba2-40b3-8059-369d6c941817")
	)
