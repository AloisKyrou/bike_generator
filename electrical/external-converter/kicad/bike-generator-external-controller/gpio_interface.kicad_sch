	)
	(text "I2C service is separate from configurable GPIO.\nNo hot-plug, 5 V tolerance or external-power backfeed qualification."
		(exclude_from_sim no)
		(at 180.34 139.7 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "6ee36e7c-98d3-438e-b0f3-b11f776b6698")
	)
	(text "Odd pins 1/3/5/7/9: GPIO2/3/4/8/10. Even pins: GND.\n3.3 V logic only; no power output. Series resistors are NOT field/ESD protection.\nGPIO2 and GPIO8 are boot straps. External circuits must preserve boot/download levels.\nHall, action, external load PWM and READY are selectable future profiles, not fixed wiring.\nNo internal dump. External loads need their own driver, power and protection."
		(exclude_from_sim no)
		(at 25.4 144.78 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "c38b0af3-9639-49e6-9418-b2b3495e8858")
	)
