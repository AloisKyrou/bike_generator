  (text "GPIO2 / GPIO8 / GPIO9 are boot straps; GPIO2/8 pullups are on GPIO_INTERFACE.\nExternal GPIO must preserve download levels. GPIO21 boot pulses are not a safety indication.\nGPIO20 / U0RXD is spare and explicitly not connected. USB remains the service interface.\nR4/R6 are the sole shared I2C pullups for input/output INA238 monitors (0x40/0x41)."
    (at 25.4 140.97 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "a6b1c372-b1aa-4431-9e0f-7e3786f73e3d")
  )
