	)
	(text "Separate output path. J40-1 -> shunt -> J41-1; pin 2 = common GND. Not galvanically isolated.\nJ41 measures receiver-terminal voltage. Keep both Kelvin paths separate from load copper.\nNo output reverse-current/reverse-polarity protection. Battery-side source fuse required.\nCurrent/voltage limits depend on converter, wiring and qualified thermal capability."
		(exclude_from_sim no)
		(at 25.4 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e0417192-2af4-4615-bd5b-4504257bdd15")
	)
