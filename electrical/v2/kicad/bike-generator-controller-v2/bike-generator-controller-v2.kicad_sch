	(text "3V3: LOGIC_POWER_USB_ONLY -> named power interfaces.\nCommon GND on all sheets. NOT galvanically isolated."
		(exclude_from_sim no)
		(at 121.92 64.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4323a92f-f8f3-4833-ab65-373893ce62f7")
	)
	(text "70 V-class target: guarded ACOV 67.47-69.68 V; NOT surge qualified.\nUse J1 DC OR J8 3-phase. Source/battery fusing and thermal proof required."
		(exclude_from_sim no)
		(at 25.4 127 0)
		(effects
			(font
				(size 1.05 1.05)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "89a4109e-91ac-4d75-b6fd-b6d3fa952b25")
	)
	(text "V2 ADAPTIVE CV / BQ TELEMETRY - 70 V-CLASS PROTOTYPE\nUSB / optional protected 1S only; no AUX. JP20 OPEN disables cell charging.\nIndependent manual/app CV; calibrate manual ~12 V / output ceiling ~1 A initially.\nInput ceiling ~13.6 A; ~400 W OUTPUT ambition, not a simultaneous V/I rating.\n67.2 V conditional on per-unit range/calibration, NOT guaranteed; static guard <69.52 V.\nMain wire links OPEN. Brownout, generator OV and receiver protection remain unqualified.\nIntegrated converter only; no external-converter branch. NO INTERNAL DUMP."
		(exclude_from_sim no)
		(at 25.4 12.7 0)
