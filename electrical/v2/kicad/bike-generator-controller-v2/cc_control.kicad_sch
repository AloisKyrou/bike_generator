	(text "U3: dual 50k, 257 positions, +/-20% track tolerance. Calibrate achievable voltage.\nPin 11: source drawing says /WP, table says NC; VDD is compatible with both. /SHDN held high.\nJ7: spare channel 0 only. Keep analog terminals within supply rails. K1: TQ2-3V / G6H-2 model.\n5.62k + 200R guards: static ceiling <69.52 V, NOT receiver-specific OVP. 67.2 V not universal."
		(exclude_from_sim no)
		(at 30.48 175.26 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "47e54a9e-ca49-4a6c-ad32-81602d87b3cf")
	)
	(text "TP45-47 are bare PCB probe pads. A/W pad must stay at its local node: no branch trace.\nUse low-capacitance probes and short ground return; these are NOT external control inputs."
		(exclude_from_sim no)
		(at 30.48 187.96 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "ac542246-d4fd-4e9b-b63f-5797e9d69d78")
	)
	(text "INDEPENDENT MANUAL / APP CV - PROTOTYPE\nGPIO20 CV_AUTO_N: low = app; high / floating = manual.\nProgram and verify target before selecting app; POR midscale is NOT 12 V.\nRelay/contact skew and brownout overvoltage are not qualified. DO NOT CONNECT A BATTERY."
		(exclude_from_sim no)
		(at 30.48 157.48 0)
		(effects
			(font
				(size 1.15 1.15)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c16a3254-c7d7-4362-838a-cc901954de72")
	)
	(text "3V3 rail discharge / leakage bleed\n0.33mA at 3.3V"
		(exclude_from_sim no)
		(at 173.99 153.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cb6f3f4a-d45b-4a24-941d-2804c1b0780d")
	)
	(text "K1.9 intentionally NC: no hard-ground path during pole skew.\nR85 and MCP B define the idle node. Brownout before relay release is still unqualified."
		(exclude_from_sim no)
		(at 30.48 151.13 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "d780435e-80aa-4ded-82f6-f1adf8260d4c")
	)
	(text "D25: low-current 27 V clamp protects 60 V Q21 drain.\nHot leakage, brownout and loop dynamics remain unqualified."
		(exclude_from_sim no)
		(at 208.28 40.64 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "f56e652b-eb59-486a-b8a8-65b200669660")
	)
