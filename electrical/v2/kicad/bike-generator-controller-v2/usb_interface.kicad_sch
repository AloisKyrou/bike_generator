	(text "5 V USB-C sink, USB 2.0 data, no USB PD. USB is the only external logic power input.\nR49/R50 are passive Rd; they do NOT detect advertised source current.\nNo active total input-current limit. JP20 OPEN disables charging, not USB-current enforcement.\nUSB source/current policy, OVP, CC protection and suspend behavior remain pending.\nJ25 is TEST ONLY: never parallel another power supply or USB host.\nCommon ground and USBLC6 ESD are NOT galvanic isolation or sustained HV fault protection."
		(exclude_from_sim no)
		(at 25.4 132.08 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "ca615360-e7f3-4016-a44d-a967f75d2a24")
	)
