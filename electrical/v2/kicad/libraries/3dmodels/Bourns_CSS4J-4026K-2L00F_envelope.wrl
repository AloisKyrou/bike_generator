#VRML V2.0 utf8

# Mechanical-envelope model for Bourns CSS4J-4026K-2L00F.
# Overall maximum envelope from the manufacturer datasheet:
# 10.06 mm x 6.60 mm x 2.93 mm.
# KiCad VRML convention: 1 model unit = 2.54 mm.
# This is not a manufacturer-supplied cosmetic model.

WorldInfo {
  title "Bourns CSS4J-4026K-2L00F mechanical envelope"
  info [
    "Overall envelope: 10.06 x 6.60 x 2.93 mm"
    "Derived from Bourns CSS4J-4026 datasheet"
  ]
}

# Lower copper alloy base, 0.43 mm high.
Transform {
  translation 0 0 0.084646
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.68 0.34 0.10
          specularColor 0.35 0.20 0.08
          shininess 0.55
        }
      }
      geometry Box { size 3.960630 2.598425 0.169291 }
    }
  ]
}

# Raised resistive section. Its top reaches the 2.93 mm maximum height.
Transform {
  translation 0 0 0.661417
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.48 0.49 0.50
          specularColor 0.55 0.55 0.55
          shininess 0.65
        }
      }
      geometry Box { size 2.724409 1.850394 0.984252 }
    }
  ]
}

# Copper end sections complete the conservative overall package envelope.
Transform {
  translation -1.651575 0 0.352362
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.72 0.38 0.12
          specularColor 0.42 0.24 0.10
          shininess 0.58
        }
      }
      geometry Box { size 0.657480 2.598425 0.704724 }
    }
  ]
}

Transform {
  translation 1.651575 0 0.352362
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.72 0.38 0.12
          specularColor 0.42 0.24 0.10
          shininess 0.58
        }
      }
      geometry Box { size 0.657480 2.598425 0.704724 }
    }
  ]
}

